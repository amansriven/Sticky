#!/bin/sh
# Run sticky from this source checkout, e.g. for the menu bar app:
#   open --env STICKY_BIN="$PWD/scripts/sticky-dev" app/build/Sticky.app
# Apps get a minimal PATH, so prefer Homebrew's Python (Sticky needs 3.10+).
here="$(cd "$(dirname "$0")/.." && pwd)"
for py in "${STICKY_PYTHON:-}" /opt/homebrew/bin/python3 /usr/local/bin/python3 python3; do
    [ -n "$py" ] && command -v "$py" >/dev/null 2>&1 && break
done
PYTHONPATH="$here/src" exec "$py" -m sticky "$@"
